# Secrets — a .env holds OPENAI_API_KEY; it must never reach GitHub
.env
.env.*
!.env.example

# Raw dataset — fetched by `python scripts/download_data.py`, never committed
data/*.csv
data/*.zip

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Notebooks
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# MLflow (local SQLite backend + artifact dir — regenerated by `src.train`)
mlflow.db
mlruns/

# Regenerated audit output — the small JSON summaries ARE committed,
# the 5 MB HTML is rebuilt by `python -m src.audit` (CI runs it every push)
artifacts/drift_report.html
